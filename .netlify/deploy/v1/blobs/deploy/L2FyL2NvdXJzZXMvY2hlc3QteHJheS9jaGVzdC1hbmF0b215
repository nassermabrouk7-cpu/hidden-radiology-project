.\"]}],[\"$\",\"p\",\"3\",{\"children\":[\"â€¢ \",\"ركّز على المناطق الحرجة: القلب والمنصف والزوايا الضلعية الحجابية.\"]}],[\"$\",\"p\",\"4\",{\"children\":[\"â€¢ \",\"تذكّر التشريح السطحي: فهم موقع الأعضاء والعظام يساعدك على تفسير الظلال.\"]}],[\"$\",\"p\",\"5\",{\"children\":[\"â€¢ \",\"لا تخفي نفسك: إذا كنت غير متأكد، ابحث عن صورة مرجعية طبيعية وقارن.\"]}]]}]}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-white mb-4\",\"children\":\"الصور\"}],[\"$\",\"div\",null,{\"className\":\"bg-brand-cyan/5 border border-brand-cyan/20 rounded-xl p-5\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-slate-200 leading-8\",\"children\":\"فهم التشريح الطبيعي لصورة الصدر هو الخطوة الأولى والأكثر أهمية في بناء مهارات قراءة أشعة الصدر. عندما تعرف كيف تبدو الصورة الطبيعية، تستطيع أن تميّز بثقة أي تغيير أو شذوذ. لا تسرع في هذا الدرس — خذ وقتك لفهم كل مكون وعلاقاته.\"}]}]]}],[\"$\",\"section\",null,{\"children\":[\"$\",\"p\",null,{\"className\":\"text-sm text-slate-500 leading-7\",\"children\":\"هذا المحتوى تعليمي لأغراض التدريب والتعلم فقط. لا يُغني عن التدريب السريري المباشر أو التقييم والتشخيص الطبي المتخصص من قبل طبيب مختص.\"}]}]]}]]}]]}]}]\nb:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"1\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"2\",{\"children\":\"ØªØ´Ø±ÙŠØ­ Ø§Ù„ØµØ¯Ø± ÙÙŠ ØµÙˆØ±Ø© Ø§Ù„Ø£Ø´Ø¹Ø© | Hidden Radiology\"}],[\"$\",\"meta\",\"3\",{\"name\":\"description\",\"content\":\"ØªØ´Ø±ÙŠØ­ Ø§Ù„ØµØ¯Ø± ÙÙŠ ØµÙˆØ±Ø© Ø§Ù„Ø£Ø´Ø¹Ø©\"}],[\"$\",\"link\",\"4\",{\"rel\":\"shortcut icon\",\"href\":\"/logos/hr-icon.png\"}],[\"$\",\"link\",\"5\",{\"rel\":\"icon\",\"href\":\"/logos/hr-icon.png\"}],[\"$\",\"link\",\"6\",{\"rel\":\"apple-touch-icon\",\"href\":\"/logos/hr-icon.png\"}]]\n1:null\n","headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/courses/layout,_N_T_/[locale]/courses/[slug]/layout,_N_T_/[locale]/courses/[slug]/