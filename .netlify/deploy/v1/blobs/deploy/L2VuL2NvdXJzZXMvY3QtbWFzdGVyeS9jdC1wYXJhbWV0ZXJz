lance between spatial detail and image noise.\"]}],[\"$\",\"p\",\"8\",{\"children\":[\"â€¢ \",\"CT parameters must be optimized together rather than considered individually.\"]}]]}]}]]}],\"$undefined\",\"$undefined\"]}]]}]]}]}]\nb:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"1\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"2\",{\"children\":\"Acquisition Parameters & Techniques | Hidden Radiology\"}],[\"$\",\"meta\",\"3\",{\"name\":\"description\",\"content\":\"Acquisition Parameters & Techniques\"}],[\"$\",\"link\",\"4\",{\"rel\":\"shortcut icon\",\"href\":\"/logos/hr-icon.png\"}],[\"$\",\"link\",\"5\",{\"rel\":\"icon\",\"href\":\"/logos/hr-icon.png\"}],[\"$\",\"link\",\"6\",{\"rel\":\"apple-touch-icon\",\"href\":\"/logos/hr-icon.png\"}]]\n1:null\n","headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/courses/layout,_N_T_/[locale]/courses/[slug]/layout,_N_T_/[locale]/courses/[slug]/[lesson]/layout,_N_T_/[locale]/courses/[slug]/[lesson]/page,_N_T_/en/courses/ct-mastery/ct-parameters"},"revalidate":false}}