# Hidden Radiology - Environment Variables
# Copy this file to .env.local and fill in your values

# Optional: Add Resend API key for email sending
# Get your key from: https://resend.com
# RESEND_API_KEY=re_xxxxxxxx

# Optional: From email address
# FROM_EMAIL=hiddenradiology@gmail.com

# Optional: To email address (where contact form messages go)
# TO_EMAIL=hiddenradiology@gmail.com
