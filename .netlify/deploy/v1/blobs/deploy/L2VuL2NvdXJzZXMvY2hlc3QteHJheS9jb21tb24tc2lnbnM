":[[\"$\",\"p\",\"0\",{\"children\":[\"â€¢ \",\"Recognize common signs used in chest X-ray interpretation.\"]}],[\"$\",\"p\",\"1\",{\"children\":[\"â€¢ \",\"Understand the silhouette sign and its clinical value.\"]}],[\"$\",\"p\",\"2\",{\"children\":[\"â€¢ \",\"Recognize the air bronchogram sign.\"]}],[\"$\",\"p\",\"3\",{\"children\":[\"â€¢ \",\"Understand the importance of the deep sulcus sign.\"]}],[\"$\",\"p\",\"4\",{\"children\":[\"â€¢ \",\"Identify common signs of volume loss and pleural abnormalities.\"]}],[\"$\",\"p\",\"5\",{\"children\":[\"â€¢ \",\"Use radiographic signs to improve anatomical localization.\"]}]]}]}]]}],[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-white mb-6\",\"children\":\"Lesson Content\"}],[\"$\",\"div\",null,{\"className\":\"space-y-8\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"Why Radiographic Signs Matter\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"Radiographic signs provide recognizable patterns that can help identify abnormalities and determine their anatomical location. They are especially useful when subtle findings are difficult to appreciate directly.\"}]]}],[\"$\",\"div\",\"1\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"The Silhouette Sign\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"The silhouette sign occurs when two structures of similar radiographic density are in direct contact and their normal border becomes indistinct. This principle can help localize an abnormal opacity to a specific region of the lung or mediastinum.\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"Air Bronchogram\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"An air bronchogram describes visible air-filled bronchi surrounded by increased alveolar opacity. It commonly occurs when the alveoli become filled with fluid, cells, or other material while the bronchi remain air-filled.\"}]]}],[\"$\",\"div\",\"3\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"Deep Sulcus Sign\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"The deep sulcus sign is an important clue to pneumothorax on a supine chest radiograph. Air may collect anteriorly and basally, causing an unusually deep and lucent costophrenic angle.\"}]]}],[\"$\",\"div\",\"4\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"Volume Loss\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"Signs of volume loss include displacement of fissures, elevation of the hemidiaphragm, crowding of pulmonary vessels, and mediastinal shift toward the affected side. Recognizing these findings helps distinguish collapse from other causes of increased lung opacity.\"}]]}],[\"$\",\"div\",\"5\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"Lobar Collapse Patterns\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"Different lobes may collapse in characteristic directions because of their anatomical attachments and surrounding structures. Knowledge of normal fissure positions and mediastinal relationships helps identify the affected lobe.\"}]]}],[\"$\",\"div\",\"6\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"Airspace Opacity\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"Airspace opacity may result from consolidation, edema, hemorrhage, or other processes that replace normal alveolar air. Assess the distribution, margins, associated air bronchograms, and other findings to help determine the likely cause.\"}]]}],[\"$\",\"div\",\"7\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"Pleural Effusion Signs\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"Pleural fluid may produce blunting of the costophrenic angle and a characteristic meniscus on an upright radiograph. On supine examinations, pleural fluid may layer posteriorly and produce less obvious findings.\"}]]}],[\"$\",\"div\",\"8\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"Pneumothorax Signs\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"A pneumothorax may appear as a visible pleural line with absence of pulmonary markings beyond it. The appearance varies with patient position, size of the pneumothorax, and technique of the examination.\"}]]}],[\"$\",\"div\",\"9\",{\"className\":\"border-l-2 border-brand-cyan/30 pl-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-white mb-3\",\"children\":\"Practical Use of Signs\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-300 leading-8\",\"children\":\"Radiographic signs should be interpreted together with the complete image and clinical context. A single sign should not be considered in isolation when determining the diagnosis.\"}]]}]]}]]}],\"$undefined\",[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2