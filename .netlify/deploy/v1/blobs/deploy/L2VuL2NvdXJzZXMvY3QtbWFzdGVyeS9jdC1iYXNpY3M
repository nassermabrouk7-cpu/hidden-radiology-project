h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-white mb-4\\\",\\\"children\\\":\\\"Lesson Objectives\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-slate-300 leading-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":[\\\"â€¢ \\\",\\\"Explain the basic principle of computed tomography.\\\"]}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":[\\\"â€¢ \\\",\\\"Describe how X-rays are used to generate CT images.\\\"]}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":[\\\"â€¢ \\\",\\\"Understand the role of the X-ray tube, detectors, and gantry.\\\"]}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":[\\\"â€¢ \\\",\\\"Explain how attenuation information is converted into CT images.\\\"]}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":[\\\"â€¢ \\\",\\\"Understand the basic concept of Hounsfield Units.\\\"]}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":[\\\"â€¢ \\\",\\\"Recognize the main components of a CT scanner.\\\"]}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":[\\\"â€¢ \\\",\\\"Understand the difference between axial, coronal, and sagittal reconstructions.\\\"]}]]}]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-white mb-6\\\",\\\"children\\\":\\\"Lesson Content\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"border-l-2 border-brand-cyan/30 pl-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-xl font-bold text-white mb-3\\\",\\\"children\\\":\\\"What Is Computed Tomography?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-slate-300 leading-8\\\",\\\"children\\\":\\\"Computed Tomography is an imaging technique that acquires multiple X-ray measurements from different angles around the patient. A computer processes these measurements to reconstruct cross-sectional images, allowing anatomical structures to be evaluated without the superimposition commonly seen on conventional radiographs.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"border-l-2 border-brand-cyan/30 pl-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-xl font-bold text-white mb-3\\\",\\\"children\\\":\\\"Basic CT Imaging Principle\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-slate-300 leading-8\\\",\\\"children\\\":\\\"During a CT examination, the X-ray tube rotates around the patient while detectors measure the radiation that passes through the body. Different tissues attenuate the X-ray beam to different degrees. The collected attenuation data are reconstructed mathematically to create an image representing the internal anatomy.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"2\\\",{\\\"className\\\":\\\"border-l-2 border-brand-cyan/30 pl-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-xl font-bold text-white mb-3\\\",\\\"children\\\":\\\"Main Components of a CT Scanner\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-slate-300 leading-8\\\",\\\"children\\\":\\\"A CT system consists of several major components, including the X-ray tube, detector array, gantry, patient table, data acquisition system, reconstruction computer, and operator console. Each component contributes to the acquisition, processing, reconstruction, or display of CT images.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"3\\\",{\\\"className\\\":\\\"border-l-2 border-brand-cyan/30 pl-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-xl font-bold text-white mb-3\\\",\\\"children\\\":\\\"X-Ray Tube\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-slate-300 leading-8\\\",\\\"children\\\":\\\"The X-ray tube generates the radiation used for CT imaging. During scanning, the tube rotates around the patient and produces a co