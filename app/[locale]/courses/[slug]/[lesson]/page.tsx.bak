  intro: arLessonIntro,
  'xray-physics': arLessonXrayPhysics,
  'image-formation': arLessonImageFormation,
  'image-quality': arLessonImageQuality,
  'radiation-safety': arLessonRadiationSafety,
  'patient-positioning': arLessonPatientPositioning,
}

